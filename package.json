{
  "name": "bbferm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @bbferm/web dev",
    "dev:store": "pnpm --filter @bbferm/store dev",
    "dev:collector": "pnpm --filter @bbferm/collector dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
