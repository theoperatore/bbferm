# Copy to .env for local development. Production values live in /etc/bbferm/collector.env.
STORE_URL=http://127.0.0.1:3100
STORE_COLLECTOR_TOKEN=dev-collector-token
# Advertisement source: "replay" (fixture file, for development) or "bluez" (not yet implemented).
COLLECTOR_SOURCE=replay
COLLECTOR_REPLAY_FILE=./test/fixtures/advertisements.json
# Minimum seconds between submitted readings per Tilt (Tilts broadcast every few seconds).
COLLECTOR_MIN_INTERVAL_S=60
COLLECTOR_QUEUE_MAX=1000
LOG_LEVEL=info
