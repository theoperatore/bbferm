{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": ["./biome/noReturnTypeAnnotations.grit", "./biome/noDestructuredProps.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase"],
            "requireAscii": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/utils", "**/utils/**", "**/lib", "**/lib/**", "**/helpers", "**/helpers/**", "**/types"],
                "message": "No utils/, lib/, helpers/ folders or generic types files. Use a descriptive name scoped to where it's used, or inline it."
              }
            ]
          }
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "PascalCase"],
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.cjs"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/packages/*/src/index.ts", "src/services/store/schema/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@bbferm/store-schema": "Only src/clients/** and *.functions.ts may use Store's schema. UI code uses this app's *.schemas.ts."
                },
                "patterns": [
                  {
                    "group": [
                      "**/utils",
                      "**/utils/**",
                      "**/lib",
                      "**/lib/**",
                      "**/helpers",
                      "**/helpers/**",
                      "**/types"
                    ],
                    "message": "No utils/, lib/, helpers/ folders or generic types files. Use a descriptive name scoped to where it's used, or inline it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/apps/web/src/clients/**", "src/apps/web/src/**/*.functions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/utils",
                      "**/utils/**",
                      "**/lib",
                      "**/lib/**",
                      "**/helpers",
                      "**/helpers/**",
                      "**/types"
                    ],
                    "message": "No utils/, lib/, helpers/ folders or generic types files. Use a descriptive name scoped to where it's used, or inline it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/clients/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyInterface": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
