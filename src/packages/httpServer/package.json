{
  "name": "@bbferm/http-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Fastify server for BBFerm services: error envelope, health checks, start/stop lifecycle",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@bbferm/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@bbferm/config": "workspace:*"
  }
}
