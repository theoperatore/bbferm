# Copy to .env for local development. Production values live in /etc/bbferm/store.env.
STORE_HOST=127.0.0.1
STORE_PORT=3100
# Separate credentials per caller.
STORE_WEB_TOKEN=dev-web-token
STORE_COLLECTOR_TOKEN=dev-collector-token
# Not used yet — the SQLite driver is selected after Pi testing (Milestone 3).
STORE_DB_PATH=./data/bbferm.sqlite
LOG_LEVEL=info
