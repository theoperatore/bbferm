{
  "name": "@bbferm/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BBFerm persistence API \u2014 sole owner of SQLite",
  "scripts": {
    "dev": "tsx watch --conditions=@bbferm/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bbferm/http-server": "workspace:*",
    "@bbferm/store-schema": "workspace:*",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bbferm/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
