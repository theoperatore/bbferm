{
  "name": "@bbferm/store-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Published schema for the Store internal API. Owned by Store; consumed by the web BFF and the collector.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@bbferm/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bbferm/domain": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bbferm/config": "workspace:*"
  }
}
